{
  "name": "@lemoncat7/dsh-partner",
  "version": "2.4.1",
  "description": "Long-lived AI companions with WeChat, Matrix and Mattermost channels for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "companion",
    "wechat",
    "weixin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "cordis.patch.yml",
    "docs/architecture.md",
    "docs/storage-migration.md",
    "docs/releases/2.0.0.md",
    "docs/releases/2.1.0.md",
    "docs/releases/2.2.0.md",
    "docs/releases/2.3.0.md",
    "docs/releases/2.4.0.md",
    "docs/releases/2.4.1.md",
    "docs/mcp.md",
    "docs/channel-questions-and-avatar.md",
    "docs/memory-quality.md",
    "docs/releases/1.12.0.md",
    "docs/releases/1.14.0.md",
    "docs/releases/1.14.1.md",
    "docs/releases/1.14.2.md",
    "docs/releases/1.15.0.md",
    "docs/releases/1.16.0.md",
    "docs/releases/1.16.1.md",
    "docs/releases/1.16.2.md",
    "docs/channel-reply-progress.md",
    "docs/channel-message-format.md",
    "docs/notification-delivery.md",
    "docs/direct-channels.md",
    "docs/THIRD_PARTY_LICENSES.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "prepare": "npm run clean && npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.2-rc.1 || ^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@dimforge/rapier3d-compat": "0.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.28",
    "@types/three": "0.185.0",
    "esbuild": "^0.25.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "three": "0.185.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemoncat7/dsh-partner.git"
  },
  "bugs": {
    "url": "https://github.com/lemoncat7/dsh-partner/issues"
  },
  "homepage": "https://github.com/lemoncat7/dsh-partner#readme"
}
